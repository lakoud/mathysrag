# REMS Environment Variables

# Database Configuration
REMS_DB_USER=rems
REMS_DB_PASSWORD=rems_pass
REMS_DB_NAME=rems

# LLM Configuration
REMS_GOOGLE_API_KEY=your_gemini_api_key_here
REMS_EVALUATION_MODEL=gemini-2.0-flash

# Chatbot API Configuration
# Inside Docker, use http://rems-app:8000 if needed, or your external chatbot URL
REMS_CHATBOT_API_URL=http://localhost:8000
REMS_CHATBOT_API_KEY=

# Optional: Overriding internal DATABASE_URL (usually managed by docker-compose)
# REMS_DATABASE_URL=postgresql://rems:rems_pass@localhost:5432/rems
